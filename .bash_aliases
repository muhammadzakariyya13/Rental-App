# Tambahkan ke ~/.bashrc atau ~/.bash_profile

# Alias untuk ngrok
alias ngrok="/c/ngrok/ngrok.exe"

# Alias untuk PHP Laragon
alias php="/c/laragon/bin/php/php-8.2.28-Win32-vs16-x64/php.exe"
alias artisan="php artisan"

# Alias untuk Laravel + Ngrok
alias laravel-serve="php artisan serve"
alias ngrok-serve="ngrok http 8000"